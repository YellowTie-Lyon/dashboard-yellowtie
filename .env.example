# Variables du frontend (Netlify > Site configuration > Environment variables).
# Ces deux valeurs sont PUBLIQUES par conception (la sécurité repose sur la RLS),
# mais on ne les commit pas pour autant.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AUCUN secret ici : ni service_role, ni token d'agent, ni webhook Discord.
# Les secrets vivent dans Supabase (secrets / Vault) et dans les secrets GitHub Actions.
